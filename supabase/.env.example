# Edge Functions only. Never copy this file into either app or source it for a client build.
# Copy to supabase/.env.local; pass explicitly with functions serve --env-file.
# Do not upload this whole file: SUPABASE_* are runtime-provided, not custom secrets to set.
# See docs/architecture/environment-variables.md. All values intentionally blank.

# Edge Functions, runtime-provided: this project's API URL; public equivalent in app templates.
# SUPABASE_URL=
# Edge Functions, runtime-provided: anon key for caller-scoped clients using the verified JWT.
# SUPABASE_ANON_KEY=
# SECRET, Edge Functions, runtime-provided: privileged key bypassing RLS. Never client-readable.
# SUPABASE_SERVICE_ROLE_KEY=

# SECRET, Edge Functions: Stripe API key; test mode for local/staging (RULE-PAY-10).
STRIPE_SECRET_KEY=
# SECRET, Edge Functions: signing secret for THIS webhook endpoint or local listener (RULE-PAY-10).
STRIPE_WEBHOOK_SECRET=
# SECRET, Edge Functions: API-restricted Google Routes/Places key, separate from every client key.
GOOGLE_MAPS_SERVER_API_KEY=
# Edge Functions only: approved Connect onboarding return URL; not a secret, never client-selected.
STRIPE_CONNECT_RETURN_URL=
# Edge Functions only: approved Connect onboarding refresh URL; not a secret, never client-selected.
STRIPE_CONNECT_REFRESH_URL=
