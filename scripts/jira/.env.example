# Jira config for scripts/jira/create-tickets.mjs
#
# Tony and Andrew both run this from the same service account, but each creates
# their own scripts/jira/.env from the password manager; never pass .env files. This example
# file is the committed record of what that config looks like: everything below is
# real except the token, which cannot be committed.
# Every variable here is for operator scripts only, never an app build or bundle.
#
# Setting up fresh (new machine, lost .env):
#   cp scripts/jira/.env.example scripts/jira/.env
#   # add JIRA_API_TOKEN from the team password manager, then:
#   set -a && source scripts/jira/.env && set +a
#   node scripts/jira/create-tickets.mjs --whoami
#
# ─────────────────────────────────────────────────────────────────────────
# This uses the shared Tetrias service account (info@tetriastech.com.au), not
# a personal one. That is deliberate: the backlog is the source of truth and
# Jira is a projection of it (backlog §4), so a bot creating the projection is
# more honest than either engineer appearing to have authored 107 issues.
#
# Tony and Andrew still log into Jira as themselves in the browser. This token
# is for the script only.
#
# The token is a shared team credential: keep it in the team password manager.
# Not in Slack, not in email, not in this repo.
# ─────────────────────────────────────────────────────────────────────────


# The shared service account.
JIRA_EMAIL=info@tetriastech.com.au

# Create at https://id.atlassian.com/manage-profile/security/api-tokens while
# logged in AS info@tetriastech.com.au — not as yourself.
# Label it "quicktrimr-backlog". Copy immediately: it is shown exactly once.
#
# The service account needs Create Issues and Assign Issues permission on the
# project, and a Jira licence. --whoami will fail clearly if it doesn't.
JIRA_API_TOKEN=

# Your Jira URL, everything before the first slash.
JIRA_BASE_URL=https://tetrias-tech.atlassian.net

# The prefix on issue keys. Issues look like TRIMR-14.
# Board: https://tetrias-tech.atlassian.net/jira/software/projects/TRIMR/boards/3
#
# THIS MUST BE TRIMR. QuickTrimr is the project display name; the stable key remains
# TRIMR. myClean is a different project on the same Atlassian site
# (key MC), and both repos' .env files export identical variable names — so a
# stale `source ../MyClean/scripts/jira/.env` in your shell would otherwise file
# QuickTrimr tickets onto the myClean board.
#
# create-tickets.mjs pins the expected key in code and refuses to run against
# anything else, twice: once against this variable, and again against what Jira
# actually returns for it. Do not "fix" a refusal by editing the constant.
JIRA_PROJECT_KEY=TRIMR

# Set only if the project has an Acceptance Criteria custom field. Run --whoami
# to find out. If blank, criteria stay in the description, which works fine.
JIRA_AC_FIELD=

# Atlassian accountIds for Tony and Andrew. Not secrets — they appear in profile
# URLs. Run --whoami to confirm they are assignable on the QuickTrimr project.
#
# The service account creates the issues; these determine who each issue is
# ASSIGNED to. Assignment follows the ticket's `owner` field in the backlog, so
# both are needed regardless of who runs the script.
JIRA_ACCOUNT_TONY=712020:eb2e05f5-34de-4899-8973-332c6913fc69
# Operator scripts only: Andrew's assignable account ID, not a credential.
JIRA_ACCOUNT_ANDREW=70121:7c9049af-f3cb-44bf-81db-a08c51897d0b
