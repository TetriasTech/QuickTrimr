{
  "name": "@quicktrimr/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./presentation": {
      "types": "./src/presentation/index.ts",
      "default": "./src/presentation/index.ts"
    },
    "./metadata": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "node": "./src/node.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@quicktrimr/shared": "workspace:*"
  },
  "peerDependencies": {
    "@expo/ui": "~57.0.20",
    "expo": "~57.0.24",
    "expo-image": "~57.0.5",
    "expo-router": "~57.0.22",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.3",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  }
}
