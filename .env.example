# Operator-only reference. Neither app loads this file; never source it for an app build.
# Each engineer creates their own ignored scripts/jira/.env from its adjacent example.
# See docs/architecture/environment-variables.md for app and Edge Function setup.

# Operator scripts only: Atlassian site for the QuickTrimr backlog projection.
JIRA_BASE_URL=https://tetrias-tech.atlassian.net
# Operator scripts only: email of the approved Jira service account.
JIRA_EMAIL=info@tetriastech.com.au
# SECRET, operator scripts only: obtain the API token from the team password manager.
JIRA_API_TOKEN=
# Operator scripts only: fixed Jira project key (not the product display name).
JIRA_PROJECT_KEY=TRIMR
# Operator scripts only: optional Acceptance Criteria custom field ID.
JIRA_AC_FIELD=
# Operator scripts only: Tony's assignable Atlassian account ID; not a credential.
JIRA_ACCOUNT_TONY=
# Operator scripts only: Andrew's assignable Atlassian account ID; not a credential.
JIRA_ACCOUNT_ANDREW=

# Runtime-owned inputs, not values to copy or override in .env:
# CI: supplied by the CI runner; read by admin Playwright configuration.
# PATH: supplied by the OS; forwarded by the isolated P0-D07 proof runner.
# EXPO_OS: supplied by Expo; read by packages/ui for platform behavior.
# INNGEST_DEV: set to 1 by the historical P0-D07 comparison proof, not the chosen engine.
# NODE_ENV: framework-owned development/production/test mode, NOT a deployment selector.
