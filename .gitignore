# Secrets — never commit
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Local agent/tool settings. Personal to each machine, and the place a token
# most easily ends up committed by accident.
.claude/settings.local.json

# Dependencies and build output
node_modules/
dist/
build/
.next/
.expo/
*.tsbuildinfo

# Supabase local state
supabase/.branches/
supabase/.temp/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs and coverage
*.log
npm-debug.log*
coverage/
