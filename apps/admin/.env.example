# Public values only, even though Next.js also runs on a server.
# Copy to .env.local in this directory; never share the filled file.
# Setup and key restrictions: ../../docs/architecture/environment-variables.md

# PUBLIC, admin browser: Supabase project API URL.
NEXT_PUBLIC_SUPABASE_URL=
# PUBLIC, admin browser: Supabase anon key, protected by RLS; never a privileged key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# PUBLIC, admin map rendering: restrict to exact website referrers and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# PUBLIC, admin monitoring: Sentry ingestion DSN, not an upload/auth token (P6-T03).
NEXT_PUBLIC_SENTRY_DSN=
# PUBLIC, admin analytics: PostHog project ingestion key, not a personal API key (P6-T04).
NEXT_PUBLIC_POSTHOG_KEY=
# PUBLIC, admin analytics: PostHog ingestion host for the selected project/region (P6-T04).
NEXT_PUBLIC_POSTHOG_HOST=
# PUBLIC, admin: deployment label used by monitoring/analytics; local, staging or production.
NEXT_PUBLIC_APP_ENV=
