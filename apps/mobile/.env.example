# Public values only. Copy to .env.local in this directory; never share the filled file.
# Every value here is extractable from the bundle. Leave unused integrations blank.
# Setup and key restrictions: ../../docs/architecture/environment-variables.md

# PUBLIC, mobile: Supabase project API URL (local/test project during development).
EXPO_PUBLIC_SUPABASE_URL=
# PUBLIC, mobile: Supabase anon key, protected by RLS; never a privileged key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# PUBLIC, mobile Android map rendering: restrict to package + signing SHA-1 and Maps SDK for Android.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
# PUBLIC, mobile iOS map rendering: restrict to bundle ID and Maps SDK for iOS.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
# PUBLIC, mobile payments: Stripe publishable key, test mode outside production.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# PUBLIC, mobile monitoring: Sentry ingestion DSN, not an upload/auth token (P6-T03).
EXPO_PUBLIC_SENTRY_DSN=
# PUBLIC, mobile analytics: PostHog project ingestion key, not a personal API key (P6-T04).
EXPO_PUBLIC_POSTHOG_KEY=
# PUBLIC, mobile analytics: PostHog ingestion host for the selected project/region (P6-T04).
EXPO_PUBLIC_POSTHOG_HOST=
# PUBLIC, mobile: deployment label used by monitoring/analytics; local, staging or production.
EXPO_PUBLIC_APP_ENV=
