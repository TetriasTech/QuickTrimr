    "@quicktrimr/shared": "workspace:*",
    "@quicktrimr/ui": "workspace:*",
    "@quicktrimr/validation": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
