{
  "expo": {
    "name": "QuickTrimr",
    "slug": "quicktrimr",
    "scheme": "quicktrimr",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-image", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    }
  }
}
