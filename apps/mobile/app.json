{
  "expo": {
    "name": "QuickTrimr",
    "slug": "quicktrimr",
    "scheme": "quicktrimr",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      [
        "expo-image-picker",
        { "cameraPermission": false, "microphonePermission": false }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    }
  }
}
